# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS) — set whichever of these apply to your deployment
FRONTEND_URL=https://your-app.example.com
VERCEL_FRONTEND_URL=https://your-app.vercel.app

# JWT Secrets — generate strong random strings, e.g. `openssl rand -hex 32`.
# Anything under 32 random characters is flagged as unsafe at startup.
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
VERIFY_EMAIL_TOKEN_SECRET=your_verify_email_token_secret_here

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=yourapp
MONGO_DB_NAME=your_database_name

# One-time seed for the public site page-view counter. The first startup sets
# this only when the analytics counter does not already exist.
SITE_INITIAL_PAGE_VIEWS=22000

# Email Configuration (Resend — OTPs, moderation notifications)
RESEND_API_KEY=your_resend_api_key
ADMIN_EMAIL=admin@example.com
APP_URL=https://your-app.example.com
# Set to "true" to email ADMIN_EMAIL on every new report; omit/false to disable.
SEND_MODERATOR_ALERTS=false

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
